---
import Icon from './Icon.astro';
import { SITE, SOCIALS, EMAIL, JENUIX_URL, NEWSLETTER_LIVE, isReady } from '../config';
const socials = SOCIALS.filter((s) => isReady(s.url));
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label={`${SITE.name}, home`}>JC</a>
        <p class="muted" style="font-size:.88rem;margin:0 0 8px">{SITE.name}</p>
        <span class="tagline">Keep learning. Keep building. Keep sharing.</span>
      </div>
      <div>
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/#collaborate">Contact</a></li>
          <li><a href="/#support">Support My Work</a></li>
        </ul>
      </div>
      <div>
        <h4>Connect</h4>
        <ul>
          {socials.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener"><Icon name={s.icon} size={16} />{s.label}</a></li>
          ))}
          {EMAIL && <li><a href={`mailto:${EMAIL}`}><Icon name="mail" size={16} />{EMAIL}</a></li>}
          {socials.length === 0 && !EMAIL && <li class="muted">Links coming soon</li>}
        </ul>
      </div>
      <div>
        <h4>Stay in the loop: JC Notes</h4>
        <p class="muted" style="font-size:.88rem;margin:0">
          Updates on new blog posts, AI experiments and practical learning resources.
        </p>
        {NEWSLETTER_LIVE
          ? <form class="sub" method="post" action="/api/subscribe">
              <input type="email" name="email" placeholder="Your email address" aria-label="Email address" required />
              <button type="submit" aria-label="Subscribe"><Icon name="arrow-right" size={18} /></button>
            </form>
          : <p class="muted" style="font-size:.85rem;margin-top:14px"><em>JC Notes is launching soon.</em></p>}
      </div>
    </div>
    <div class="bottom">
      <span>© <span id="year">2026</span> {SITE.name}. All rights reserved.</span>
      {isReady(JENUIX_URL)
        ? <a href={JENUIX_URL}>Explore My Creative Studio, Jenuix Creatives ↗</a>
        : <span>Jenuix Creatives: link coming soon</span>}
      <span>Designed with purpose</span>
    </div>
  </div>
</footer>